Mplus VERSION 8.3
MUTHEN & MUTHEN
05/14/2026  11:55 PM

INPUT INSTRUCTIONS

  TITLE:
    PILOT EMA-derived 3-state unconditional LTA (configural);

  DATA:
    FILE IS lta_primary_z_wide.dat;

  VARIABLE:
    NAMES ARE
      id st1 en1 bu1 be1 lo1 si1 saw1
      sap1 st2 en2 bu2 be2 lo2 si2 saw2
      sap2 st3 en3 bu3 be3 lo3 si3 saw3
      sap3 st4 en4 bu4 be4 lo4 si4 saw4
      sap4;
    USEVARIABLES ARE
      st1 en1 bu1 be1 lo1 st2 en2 bu2
      be2 lo2 st3 en3 bu3 be3 lo3 st4
      en4 bu4 be4 lo4;
    IDVARIABLE IS id;
    CLASSES = c1(3) c2(3) c3(3) c4(3);
    MISSING ARE ALL (-999);

  ANALYSIS:
    TYPE = MIXTURE;
    STARTS = 200 50;
    STITERATIONS = 20;
    PROCESSORS = 4;

  MODEL:
  %OVERALL%
    st1 st2 st3 st4 (vst);
    en1 en2 en3 en4 (ven);
    bu1 bu2 bu3 bu4 (vbu);
    be1 be2 be3 be4 (vbe);
    lo1 lo2 lo3 lo4 (vlo);

    c2 ON c1;
    c3 ON c2;
    c4 ON c3;

  MODEL c1:
    %c1#1%
      [st1];
      [en1];
      [bu1];
      [be1];
      [lo1];
    %c1#2%
      [st1];
      [en1];
      [bu1];
      [be1];
      [lo1];
    %c1#3%
      [st1];
      [en1];
      [bu1];
      [be1];
      [lo1];

  MODEL c2:
    %c2#1%
      [st2];
      [en2];
      [bu2];
      [be2];
      [lo2];
    %c2#2%
      [st2];
      [en2];
      [bu2];
      [be2];
      [lo2];
    %c2#3%
      [st2];
      [en2];
      [bu2];
      [be2];
      [lo2];

  MODEL c3:
    %c3#1%
      [st3];
      [en3];
      [bu3];
      [be3];
      [lo3];
    %c3#2%
      [st3];
      [en3];
      [bu3];
      [be3];
      [lo3];
    %c3#3%
      [st3];
      [en3];
      [bu3];
      [be3];
      [lo3];

  MODEL c4:
    %c4#1%
      [st4];
      [en4];
      [bu4];
      [be4];
      [lo4];
    %c4#2%
      [st4];
      [en4];
      [bu4];
      [be4];
      [lo4];
    %c4#3%
      [st4];
      [en4];
      [bu4];
      [be4];
      [lo4];

  OUTPUT:
    TECH1 TECH4 TECH8 TECH15;

  SAVEDATA:
    FILE IS lta_3state_configural_pilot_cprob.dat;
    SAVE = CPROBABILITIES;



*** WARNING in MODEL command
  All variables are uncorrelated with all other variables within class.
  Check that this is what is intended.
