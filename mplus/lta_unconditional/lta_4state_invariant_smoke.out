      [be3] (mbe4);
      [lo3] (mlo4);

  MODEL c4:
    %c4#1%
      [st4] (mst1);
      [en4] (men1);
      [bu4] (mbu1);
      [be4] (mbe1);
      [lo4] (mlo1);
    %c4#2%
